<?xml version="1.0" encoding="utf-8"?>
<!-- P201 step 3: night mode for the platform dialogs and forms. Same styles as values/themes.xml on the dark Material
     parents, with the Glass night tokens (accent, text, graphite sheet). Colours mirror Glass and Kit in Chrome.kt and
     GlassKit.kt; keep them in step. -->
<resources>
    <color name="glass_accent">#0a84ff</color>
    <color name="glass_text">#f2f4f8</color>
    <color name="glass_secondary">#a3acbd</color>
    <color name="glass_sheet">#23272f</color>
    <color name="glass_sheet_edge">#1affffff</color>

    <style name="Theme.Scribella" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/ink</item>
        <item name="android:colorPrimaryDark">@color/ink</item>
        <item name="android:colorAccent">@color/glass_accent</item>
        <item name="android:colorControlActivated">@color/glass_accent</item>
        <item name="android:colorControlHighlight">#330a84ff</item>
        <item name="android:textColorPrimary">@color/glass_text</item>
        <item name="android:textColorSecondary">@color/glass_secondary</item>
        <item name="android:alertDialogTheme">@style/Theme.Scribella.Dialog</item>
        <item name="android:dialogTheme">@style/Theme.Scribella.Dialog</item>
        <item name="android:windowSplashScreenBackground">@color/launcher_field_night</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launcher_background</item>
    </style>

    <style name="Theme.Scribella.Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_surface</item>
        <item name="android:backgroundDimAmount">0.55</item>
        <item name="android:colorAccent">@color/glass_accent</item>
        <item name="android:colorControlActivated">@color/glass_accent</item>
        <item name="android:colorControlHighlight">#330a84ff</item>
        <item name="android:textColorPrimary">@color/glass_text</item>
        <item name="android:textColorSecondary">@color/glass_secondary</item>
        <item name="android:windowTitleStyle">@style/Scribella.DialogTitle</item>
        <item name="android:buttonBarButtonStyle">@style/Scribella.DialogButton</item>
        <item name="android:windowAnimationStyle">@style/Scribella.DialogMotion</item>
    </style>

    <style name="Scribella.DialogButton" parent="@android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/glass_accent</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>
</resources>
