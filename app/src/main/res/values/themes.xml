<?xml version="1.0" encoding="utf-8"?>
<!-- Platform theme tuned to the Chrome.kt tokens (P026): the app's own dialog surface and sentence-case buttons.
     G7 (P182): controls and every platform dialog follow the Glass tokens (accent, text, 20 dp card radius), so export,
     scan, study and the other forms match the Glass chrome. Colours mirror Glass in Chrome.kt; keep both in step. -->
<resources>
    <color name="ink">#182636</color>
    <color name="glass_accent">#0a66d9</color>
    <color name="glass_text">#1d2433</color>
    <color name="glass_secondary">#566074</color>
    <color name="glass_sheet">#fbfcfe</color>
    <color name="glass_sheet_edge">#ffffffff</color>
    <!-- P201 step 3: values-night/themes.xml holds the night versions of these colours and styles. -->

    <style name="Theme.Scribella" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/ink</item>
        <item name="android:colorPrimaryDark">@color/ink</item>
        <item name="android:colorAccent">@color/glass_accent</item>
        <item name="android:colorControlActivated">@color/glass_accent</item>
        <item name="android:colorControlHighlight">#1f0a66d9</item>
        <item name="android:textColorPrimary">@color/glass_text</item>
        <item name="android:textColorSecondary">@color/glass_secondary</item>
        <item name="android:alertDialogTheme">@style/Theme.Scribella.Dialog</item>
        <item name="android:dialogTheme">@style/Theme.Scribella.Dialog</item>
        <!-- Launch screen (platform SplashScreen, API 31+): pale glass with the launcher icon; no added delay. -->
        <item name="android:windowSplashScreenBackground">@color/launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launcher_background</item>
    </style>

    <style name="Theme.Scribella.Dialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_surface</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="android:colorAccent">@color/glass_accent</item>
        <item name="android:colorControlActivated">@color/glass_accent</item>
        <item name="android:colorControlHighlight">#1f0a66d9</item>
        <item name="android:textColorPrimary">@color/glass_text</item>
        <item name="android:textColorSecondary">@color/glass_secondary</item>
        <item name="android:windowTitleStyle">@style/Scribella.DialogTitle</item>
        <item name="android:buttonBarButtonStyle">@style/Scribella.DialogButton</item>
        <item name="android:windowAnimationStyle">@style/Scribella.DialogMotion</item>
    </style>

    <style name="Scribella.DialogTitle" parent="@android:style/TextAppearance.Material.DialogWindowTitle">
        <item name="android:textColor">@color/glass_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Scribella.DialogButton" parent="@android:style/Widget.Material.Light.Button.Borderless.Colored">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/glass_accent</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="Scribella.DialogMotion" parent="">
        <item name="android:windowEnterAnimation">@anim/popover_enter</item>
        <item name="android:windowExitAnimation">@anim/popover_exit</item>
    </style>

    <!-- Floating popovers (menus, tool options): a short fade with a slight grow; system animation scale applies. -->
    <style name="Scribella.PopoverMotion" parent="">
        <item name="android:windowEnterAnimation">@anim/popover_enter</item>
        <item name="android:windowExitAnimation">@anim/popover_exit</item>
    </style>
</resources>
