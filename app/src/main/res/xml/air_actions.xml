<?xml version="1.0" encoding="utf-8"?>
<!-- User assigns/enables actions in Samsung settings. No forced defaults. -->
<remote-actions version="1.2" actionset_label="@string/air_actions_title">
    <action id="next_page" label="@string/air_next_page" priority="1" trigger_key="PAGE_DOWN" />
    <action id="previous_page" label="@string/air_previous_page" priority="2" trigger_key="PAGE_UP" />
    <action id="undo" label="@string/air_undo" priority="3" trigger_key="CTRL_LEFT+Z" />
    <action id="redo" label="@string/air_redo" priority="4" trigger_key="CTRL_LEFT+Y" />
    <action id="copy" label="@string/air_copy" priority="5" trigger_key="CTRL_LEFT+C" />
    <action id="cut" label="@string/air_cut" priority="6" trigger_key="CTRL_LEFT+X" />
    <action id="paste" label="@string/air_paste" priority="7" trigger_key="CTRL_LEFT+V" />
    <action id="search" label="@string/air_search" priority="8" trigger_key="CTRL_LEFT+F" />
</remote-actions>
